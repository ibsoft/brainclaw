# Copy to .env and set a strong local-only key.
MEMORY_API_KEY=replace-with-a-long-random-local-key

# BrainClaw binds to localhost by default. Do not expose publicly unless you add
# TLS, firewalling, and stronger operational controls.
HOST=127.0.0.1
PORT=8757
LOG_LEVEL=INFO

DATA_DIR=data
SQLITE_PATH=data/memory.sqlite3
FAISS_INDEX_PATH=data/faiss.index
ID_MAP_PATH=data/id_map.json
UPLOAD_DIR=data/uploads

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
MAX_CONTENT_CHARS=100000
MAX_UPLOAD_BYTES=10485760
MAX_QUERY_CHARS=4000
MAX_TOP_K=50
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=160
