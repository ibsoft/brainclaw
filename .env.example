# Copy to .env and set a strong local-only key.
MEMORY_API_KEY=replace-with-a-long-random-local-key

# BrainClaw binds to localhost by default. Do not expose publicly unless you add
# TLS, firewalling, and stronger operational controls.
HOST=127.0.0.1
PORT=8757
LOG_LEVEL=INFO
LOG_FILE=data/logs/brainclaw.jsonl
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
BRAINCLAW_SCHEME=http
BRAINCLAW_SSL_CERTFILE=
BRAINCLAW_SSL_KEYFILE=

DATA_DIR=data
SQLITE_PATH=data/memory.sqlite3
FAISS_INDEX_PATH=data/faiss.index
ID_MAP_PATH=data/id_map.json
INDEX_DIR=data/indexes
UPLOAD_DIR=data/uploads
ISOLATE_INDEXES=true

ADMIN_USERNAME=admin
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
MAX_CONTENT_CHARS=100000
MAX_UPLOAD_BYTES=10485760
MAX_QUERY_CHARS=4000
MAX_TOP_K=50
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=160
