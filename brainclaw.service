[Unit]
Description=OpenClaw BrainClaw local memory service
After=network.target

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/opt/brainclaw
EnvironmentFile=/opt/brainclaw/.env
ExecStart=/opt/brainclaw/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8757
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/brainclaw/data

[Install]
WantedBy=multi-user.target

